# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Stage 1 - dependencies
# devDependencies are required here: Vite, Tailwind, PostCSS and the PWA plugin
# all run at build time. None of them reach the runtime stage.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS deps

WORKDIR /app

ENV npm_config_update_notifier=false \
    npm_config_fund=false \
    npm_config_audit=false

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

# ---------------------------------------------------------------------------
# Stage 2 - build
# Vite inlines env variables at build time, so every VITE_* value must be known
# here. They are public client-side values, not secrets.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS build

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build

# ---------------------------------------------------------------------------
# Stage 3 - runtime
# Static assets only: no Node.js, no npm, no sources, no package manager.
# The unprivileged image runs as uid 101 and listens on 8080, so the container
# needs no root capability and works with a read-only root filesystem.
# ---------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html

EXPOSE 8080

# Probed by compose and by the deployment pipeline through the published port
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --spider http://127.0.0.1:8080/health || exit 1
