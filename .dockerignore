# Dependencies are installed inside the image, never copied from the host
node_modules

# Build outputs
dist
dist-ssr
coverage
*.local

# Secrets: values are injected as build args (prod) or mounted at runtime (dev)
.env
.env.*
!.env.example

# VCS & CI
.git
.gitignore
.github

# Editor / OS
.vscode
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker & docs: changing them must not invalidate the build cache
Dockerfile*
.dockerignore
docker-compose*.yml
README.md
apache.conf
